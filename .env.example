# Server
PORT=3000

UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_UPLOAD_MB=500
JOB_TTL_HOURS=48

# Database (local Postgres)
DATABASE_URL=postgres://localhost/reelsmith

# Providers: use mock/heuristic to run offline with no API keys
TRANSCRIBE_PROVIDER=mock    # mock | whisper (OpenAI, local backup) | local (free, run: npm run setup:whisper)
PLANNER_PROVIDER=heuristic  # heuristic | claude
TRACK_PROVIDER=off          # off | onnx

# API keys (only needed for whisper / claude)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local Whisper (optional; these are the defaults)
# WHISPER_CPP_BIN=whisper-cli
# WHISPER_CPP_MODEL=models/ggml-base.bin
